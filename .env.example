# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-...
MAGIC_HOUR_API_KEY=mhk_live_...
GEMINI_API_KEY=...
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
GEMINI_TTS_VOICE=Achird
NARRATION_PROVIDER=gemini
MAGIC_HOUR_IMAGE_MODEL=nano-banana-2
MAGIC_HOUR_IMAGE_FALLBACK_MODEL=nano-banana
MAGIC_HOUR_THUMBNAIL_GENERATION_ENABLED=true
MAGIC_HOUR_THUMBNAIL_RESOLUTION=2k

# Quality-first writer and independent verifier via OpenRouter
OPENROUTER_MODEL=anthropic/claude-opus-4.7
OPENROUTER_VERIFY_MODEL=openai/gpt-5.4
OPENROUTER_STARTING_BALANCE_USD=0
OPENROUTER_FIDELITY_MAX_REQUEST_USD=3

# Scene-level YouTube b-roll discovery. Discovery stores links and timestamps;
# video is downloaded only after the existing rights approval gate.
OPENAI_API_KEY=sk-...
OPENAI_BROLL_MODEL=gpt-5.6
YOUTUBE_API_KEY=...
YOUTUBE_BROLL_ENABLED=true

# Voice: path to your recorded narrator sample (2-3 min, quiet room, mp3/wav).
# If set, the pipeline clones this voice. Must be a voice you have rights to.
VOICE_SAMPLE=assets/voices/channel_narrator_approved_english_clean.wav
VOICE_CONSENT_FILE=assets/voice_consent.txt
NARRATION_TAIL_PADDING_SECONDS=0.35

# Current quality-first Magic Hour motion-only routing
MAGIC_HOUR_VIDEO_MODEL=veo3.1
MAGIC_HOUR_VIDEO_FALLBACK_MODEL=kling-3.0
MAGIC_HOUR_PREMIUM_MOTION_MODELS=veo3.1:1080p,kling-3.0:1080p,seedance:1080p
MAGIC_HOUR_SEEDANCE_MOTION_ENABLED=true
MAGIC_HOUR_SEEDANCE_MOTION_SHARE=0.50
MAGIC_HOUR_SEEDANCE_MOTION_MODELS=seedance:1080p,kling-3.0:1080p,veo3.1:1080p
# Occasional source-adjacent explanation clips for invisible mechanisms.
# These are text-free visualizations, never evidence or ordinary b-roll.
MAGIC_HOUR_CONCEPT_ANIMATIONS_ENABLED=true
MAGIC_HOUR_CONCEPT_ANIMATION_MODELS=kling-3.0:1080p,veo3.1:1080p
REMOTION_DIR=remotion
REMOTION_RENDER_ENABLED=true
REMOTION_RENDER_STRICT=true
REMOTION_RENDER_CRF=12
REMOTION_RENDER_CONCURRENCY=50%
# Optional when Chrome is not auto-detected.
REMOTION_BROWSER_EXECUTABLE=
CAPTURE_AI_PLANNER_ENABLED=true
CAPTURE_PARALLELISM=4
MAX_CAPTURE_RECORDINGS=6
# Generic AI b-roll remains disabled. Thumbnail generation is separately controlled above.
GENERATIVE_VISUALS_ENABLED=false
MIN_EPISODE_CREDITS=0
MAX_EPISODE_CREDITS=15000
MAGIC_HOUR_STARTING_BALANCE_CREDITS=0
FIDELITY_BUDGET_FRACTION=0.30
FIDELITY_CORPUS_SIZE=30
AI_LABS_MOTION_CORPUS_SIZE=56
AI_LABS_MOTION_DATA_DIR=data/motion_expert_runs
AI_LABS_MOTION_PROFILE_PATH=configs/ai_labs_motion_expert.json
AI_LABS_MOTION_TRAIN_MODEL=anthropic/claude-opus-4.7
AI_LABS_MOTION_REVIEW_MODEL=openai/gpt-5.4
MAX_PREMIUM_MOTION_VARIANTS=12

# Worker service. Use a long random token in production.
WORKER_API_TOKEN=replace-with-a-long-random-token
WORKER_PUBLIC_BASE_URL=https://video-worker.example.com
EPISODE_DATA_DIR=/data/episodes
JOB_DB_PATH=/data/jobs.sqlite3
MUSIC_DIR=/data/music

# Optional: n8n instance, for scheduling/notifications later.
# Create the key in n8n: Settings -> n8n API -> Create an API key
N8N_BASE_URL=https://n8n.srv1460077.hstgr.cloud
N8N_API_KEY=
