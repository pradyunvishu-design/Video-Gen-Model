{
  "name": "local-recording-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.16"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/dev.mjs --doctor",
    "web:dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "desktop:build": "node scripts/dev.mjs --build",
    "test": "vitest run",
    "test:bootstrap": "node --test scripts/dev.test.mjs",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.1",
    "jsdom": "^27.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@playwright/test": "^1.58.0"
  }
}
