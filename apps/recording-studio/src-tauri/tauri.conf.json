{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Recording Studio",
  "version": "0.1.0",
  "identifier": "local.magichour.recording-studio",
  "build": {"beforeDevCommand":"npm run web:dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"label":"main","title":"Local Recording Studio","width":1280,"height":850,"minWidth":960,"minHeight":680}],
    "security": {"csp":"default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost", "assetProtocol":{"enable":true,"scope":["$APPDATA/projects/**"]}}
  },
  "bundle": {"active":true,"targets":"all","macOS":{"minimumSystemVersion":"15.0"}}
}
