# No credentials are required for local recording or export.
# Optional absolute executable paths if the tools are not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional local-only speech transcription. Never insert API keys into frontend VITE_* variables.
# WHISPER_CLI_PATH=/absolute/path/to/whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.en.bin
