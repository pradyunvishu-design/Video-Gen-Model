      "id": "review-form",
      "name": "Review Seven Briefs",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const slate = $('Load Slate').first().json;\nconst fallbackOrder = slate.episodes.map(e => e.episode_id);\nconst entered = String($json['Production order (episode IDs)'] || '').split(/[\\n,]+/).map(v => v.trim()).filter(Boolean);\nconst order = entered.length ? entered : fallbackOrder;\nconst known = new Set(fallbackOrder);\nif (order.some(id => !known.has(id)) || new Set(order).size !== order.length) throw new Error('Production order contains an unknown or duplicate episode ID');\nconst decisions = slate.episodes.map((episode, index) => {\n  const action = String($json[`Episode ${index + 1} decision`] || 'Revise').toLowerCase();\n  return {episode_id: episode.episode_id, action, approved: action === 'approve', notes: String($json[`Episode ${index + 1} notes`] || ''), order: order.indexOf(episode.episode_id) + 1};\n});\nreturn [{json:{slate_id:slate.slate_id, decisions}}];"
      },
      "id": "build-decisions",
      "name": "Build Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://video-worker.example.com/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({stage:'review_slate', payload:$json, idempotency_key:'review-' + $json.slate_id + '-' + Date.now()}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "submit",
      "name": "Submit Slate Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        100
      ]
    }
