          "formDescription": "={{ $json.episodes.map((e,i) => '### ' + (i+1) + '. ' + e.brief.title + '\n**ID:** ' + e.episode_id + ' Â· **Format:** ' + e.brief.episode_format + ' Â· **Evidence:** ' + e.brief.source_ids.length + ' sources\n\n**Thesis:** ' + e.brief.thesis + '\n\n**Why now:** ' + e.brief.why_now + '\n\n**Visual plan:** ' + e.brief.visual_opportunities.join('; ')).join('\n\n---\n\n') }}",
