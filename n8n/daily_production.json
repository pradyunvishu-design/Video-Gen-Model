{
  "name": "AI Media v2 - Daily Production",
  "nodes": [
    {
      "parameters": {
        "content": "## Daily production\n\nRuns at 2 AM Central and produces the oldest approved episode due today. Local private drafts are auto-approved after QC. It never uploads to YouTube.",
        "height": 260,
        "width": 420,
        "color": 4
      },
      "id": "note",
      "name": "Production Gate",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 2,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily 2 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://video-worker.example.com/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({stage:'produce_next', payload:{scheduled_date:$now.toFormat('yyyy-LL-dd')}, idempotency_key:'daily-' + $now.toFormat('yyyy-LL-dd')}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "production-job",
      "name": "Start Daily Production",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait 30 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "url": "=https://video-worker.example.com/jobs/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "status",
      "name": "Check Production",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "complete",
      "name": "Production Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "canceled",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "paused",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "failed",
      "name": "Production Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "episode",
              "name": "episode_id",
              "value": "={{ $json.result.episode_id }}",
              "type": "string"
            },
            {
              "id": "preview",
              "name": "preview_url",
              "value": "={{ $json.result.preview_url }}",
              "type": "string"
            },
            {
              "id": "package",
              "name": "package_url",
              "value": "={{ $json.result.preview_urls.package }}",
              "type": "string"
            },
            {
              "id": "qc",
              "name": "qc",
              "value": "={{ $json.result.qc }}",
              "type": "object"
            },
            {
              "id": "review",
              "name": "review_instruction",
              "value": "Open the published Final Review workflow form with this episode_id.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ready",
      "name": "Preview Ready",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1220,
        20
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Video worker stopped with status ' + $json.status + ': ' + ($json.error || 'unknown error') }}"
      },
      "id": "stop",
      "name": "Stop on Worker Error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1440,
        220
      ]
    }
  ],
  "connections": {
    "Daily 2 AM": {
      "main": [
        [
          {
            "node": "Start Daily Production",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test": {
      "main": [
        [
          {
            "node": "Start Daily Production",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Daily Production": {
      "main": [
        [
          {
            "node": "Wait 30 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 Seconds": {
      "main": [
        [
          {
            "node": "Check Production",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Production": {
      "main": [
        [
          {
            "node": "Production Complete?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Production Complete?": {
      "main": [
        [
          {
            "node": "Preview Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Production Failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Production Failed?": {
      "main": [
        [
          {
            "node": "Stop on Worker Error",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 30 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Chicago",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "active": false
}
