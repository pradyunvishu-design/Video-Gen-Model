{
  "name": "News Weekly - Research and Episode Plan",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 0"
            }
          ]
        }
      },
      "id": "weekly-trigger",
      "name": "Sunday 6 PM Central",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://video-worker.example.com/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"stage\":\"refresh_sources\",\"payload\":{},\"idempotency_key\":\"news-weekly-refresh-{{ $now.toFormat('yyyy-LL-dd') }}\"}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "refresh",
      "name": "Refresh News Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        80
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-refresh",
      "name": "Wait for Research",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        500,
        80
      ]
    },
    {
      "parameters": {
        "url": "=https://video-worker.example.com/jobs/{{ $('Refresh News Sources').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "check-refresh",
      "name": "Check Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "research-complete",
      "name": "Research Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://video-worker.example.com/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"stage\":\"research_news_weekly\",\"payload\":{},\"idempotency_key\":\"news-weekly-plan-{{ $now.toFormat('yyyy-LL-dd') }}\"}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "plan-weekly",
      "name": "Plan News Weekly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1230,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "=News Weekly planning started. Job: {{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ready",
      "name": "Weekly Plan Started",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1480,
        0
      ]
    }
  ],
  "connections": {
    "Sunday 6 PM Central": {
      "main": [
        [
          {
            "node": "Refresh News Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test": {
      "main": [
        [
          {
            "node": "Refresh News Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh News Sources": {
      "main": [
        [
          {
            "node": "Wait for Research",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Research": {
      "main": [
        [
          {
            "node": "Check Research",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Research": {
      "main": [
        [
          {
            "node": "Research Complete?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Research Complete?": {
      "main": [
        [
          {
            "node": "Plan News Weekly",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for Research",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plan News Weekly": {
      "main": [
        [
          {
            "node": "Weekly Plan Started",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Chicago",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "active": false
}
